# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SERVICE_NAME=flightai

# ── Database (Cloud SQL / PostgreSQL) ────────────────────────────────────────
# Dev: run `docker run -e POSTGRES_PASSWORD=password -p 5432:5432 postgres:16`
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/flightai

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-minimum-32-chars-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── Amadeus ───────────────────────────────────────────────────────────────────
# Get from: https://developers.amadeus.com
# Test environment: https://test.api.amadeus.com
# Production: https://api.amadeus.com (requires production access application)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Twilio (SMS notifications) ────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── SendGrid (email notifications) ───────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@flightai.io

# ── Redis (price deduplication cache) ─────────────────────────────────────────
# Dev: docker run -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379/0

# ── GCS / ML Model ────────────────────────────────────────────────────────────
GCS_MODEL_BUCKET=flightai-models
XGBOOST_MODEL_PATH=models/xgboost_v0.pkl

# ── Pub/Sub Topics ────────────────────────────────────────────────────────────
PUBSUB_TOPIC_PRICE_UPDATED=price-updated
PUBSUB_TOPIC_BOOKING_CONFIRMED=booking-confirmed
PUBSUB_TOPIC_BOOKING_FAILED=booking-failed
PUBSUB_TOPIC_WALLET_LOW=wallet-low
