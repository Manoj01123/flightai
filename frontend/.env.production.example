# Copy this file to .env.production and fill in your values.
# .env.production is NOT committed to git — it stays local for Cloud Build uploads.

# Cloud Run gateway URL (output of: gcloud run services describe gateway --format='value(status.url)')
VITE_API_URL=https://your-gateway-url.run.app

# Stripe publishable key (from https://dashboard.stripe.com/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Web Push VAPID public key (generated with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
